BOT_TOKEN=
# Render Free runs on ephemeral storage. Set this to 1 only with a real mounted disk.
VAULTX_REQUIRE_PERSISTENT_STORAGE=0
# For persistent storage use /var/data/vaultx. Leave blank for current Render Free.
VAULTX_DATA_DIR=
# One-time recovery ONLY after comparing the bundled JSON with the latest customer ledger.
VAULTX_BOOTSTRAP_FROM_BUNDLE=
ADMIN_IDS=
GRIZZLY_API_KEY=
HERO_API_KEY=
HERO_SMS_API_KEY=
HERO_BASE_URL=https://hero-sms.com/stubs/handler_api.php
GRIZZLY_BASE_URL=https://api.grizzlysms.com/stubs/handler_api.php
SMM_API_URL=
SMM_API_KEY=
# Optional public catalog URLs; defaults use this repository's provider-catalog branch.
VAULTX_PUBLIC_CATALOG_URL=
VAULTX_PUBLIC_SMM_CATALOG_URL=
SMM_PROXY_URL=
SMS_PROXY_URL=
HERO_PROXY_URL=
GRIZZLY_PROXY_URL=
TELEGRAM_PROXY_URL=
TELEGRAM_BASE_API_URL=
GAME_TOPUP_API_URL=
GAME_TOPUP_API_KEY=
